{
  "name": "pith",
  "version": "0.4.1",
  "private": true,
  "description": "Pith: We used all human wisdom to train AI. Pith uses AI's training pipeline to train you.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --typeRoots ./node_modules/@types",
    "test": "node --experimental-strip-types --import ./tests/setup.ts --test tests/*.test.ts",
    "test:file": "node --experimental-strip-types --import ./tests/setup.ts --test",
    "test:browser": "node scripts/test-browser.mjs",
    "build:obsidian": "node scripts/build-obsidian.mjs",
    "install:obsidian": "npm run build:obsidian && node scripts/install-obsidian.mjs",
    "verify:obsidian": "npm run build:obsidian && node --experimental-strip-types scripts/verify-obsidian-e2e.ts",
    "web": "node --experimental-strip-types src/shells/web/cli.ts"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
